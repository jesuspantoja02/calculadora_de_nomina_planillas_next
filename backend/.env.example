# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3001
# Base de datos SQLite (se crea sola al iniciar)
DATABASE_FILE=data/nomina.db
# Peticiones máximas por IP cada 15 minutos (solo aplica en production)
RATE_LIMIT_MAX=1000
# Firma de tokens de sesión (mín. 16 caracteres; cambiar en producción)
AUTH_SECRET=dev-nomina-auth-secret-cambiar-en-prod
# Duración del token en horas
AUTH_TOKEN_TTL_HOURS=12
# Asistente IA (obligatorio para el chat). Solo API externa; nunca IA local ni Cursor.
# Ejemplo Groq: https://console.groq.com
# AI_API_KEY=gsk_...
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
