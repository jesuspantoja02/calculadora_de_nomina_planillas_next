# --- Secretos y entorno local (sí se suben los *.example) ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
secrets/
credentials*.json

# --- SQLite en runtime (DNI, boletas, tasas). La carpeta queda con .gitkeep ---
backend/data/*
!backend/data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*-journal

# --- Logs, caché y cobertura ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_*/
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# --- Sistema operativo ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Editores e IDE ---
.idea/
*.iml
.vscode/*
