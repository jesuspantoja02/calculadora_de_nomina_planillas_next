!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Herramientas locales del agente / diseño (no son del producto del curso) ---
.cursor/
.agents/
.grok/
.impeccable/
.taste-skill/
skills-lock.json
__pycache__/
*.py[cod]
*$py.class
.Python
