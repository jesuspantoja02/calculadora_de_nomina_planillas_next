# =============================================================================
# Nómina / planillas — lo que NO se versiona
# =============================================================================

# --- Dependencias ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Compilados y artefactos de build ---
dist/
build/
out/
out-tsc/
.angular/
.vite/
.next/
.turbo/
.vercel/
